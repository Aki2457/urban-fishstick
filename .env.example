# Copy to .env and edit. Variables already set in the real environment win over this file.
# Names work in lower case (as below) or upper case (APP_NAME).

# ---- Server (always read from the environment, even with app_config=true) ----
# PORT=3000
# HOST=127.0.0.1          # 0.0.0.0 to accept outside connections
# DATA_DIR=./data

# ---- Settings source ----
# true: ignore everything below and manage settings in the whiteboard's Settings Bar
#       (saved to DATA_DIR/app-config.json).
app_config=false

# ---- App ----
app_name=Auth Flow
# Public address. Passkeys, cookies and site links use it. https:// required on a public server.
# app_url=https://auth.example.com
# Create ada@example.com / grace@example.com with known passwords on first start. Turn off in production.
app_seed_demo_users=true

# ---- Testing mode ----
# Only listed testers can sign in or sign up.
enable_app_testing=false
# Emails or @domain entries, comma separated.
# app_testing_allowlist=you@example.com,@yourcompany.com

# ---- Email ----
# When false, the Verification Email node is hidden and nothing below is required.
enable_email=false
# smtp | api | api-smtp (API, then SMTP if it fails) | smtp-api (SMTP, then API) | console (log only, localhost only)
# email_type=smtp
# email_from=no-reply@example.com     # defaults to email_smtp_username when that is an email
# email_from_name=Auth Flow           # defaults to app_name

# ---- SMTP (needed when email_type includes smtp) ----
# email_smtp_server=https://smtp.gmail.com   # scheme required (https://, smtp:// or smtps://), not case sensitive
# email_smtp_useauth=true
# email_smtp_tlsorssl=tls                    # tls = STARTTLS (port 587), ssl = TLS from the start (port 465)
# email_smtp_port=587
# email_smtp_username=example@gmail.com
# email_smtp_password=                       # Gmail: use an app password

# ---- Email API (needed when email_type includes api) ----
# email_api_provider=generic                 # generic | resend | sendgrid | postmark
# email_api_url=https://mail.example.com/send   # required for generic; optional override for the others
# email_api_key=
